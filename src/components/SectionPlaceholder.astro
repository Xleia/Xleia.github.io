---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  phase: string;
}

const { eyebrow, title, summary, phase } = Astro.props;
---

<section class="page-intro" aria-labelledby="section-title">
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="section-title">{title}</h1>
  <p class="lead">{summary}</p>
  <p class="status-note">
    <span class="status-dot" aria-hidden="true"></span>
    {phase} · 当前为导航结构占位页，正式内容稍后实现。
  </p>
  <a class="text-link" href="/">返回首页 <span aria-hidden="true">→</span></a>
</section>
