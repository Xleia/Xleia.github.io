---
import { getCollection } from 'astro:content';
import { PROJECTS, projectPath } from '../data/projects';
import { SITE, NAV_ITEMS } from '../data/site';
import '../styles/landing.css';

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);
const [featured, ...latest] = articles;
const date = (value: Date) => value.toISOString().slice(0, 10);
const links = NAV_ITEMS;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={SITE.description} />
  <meta name="theme-color" content="#473938" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={SITE.name} />
  <meta property="og:description" content={SITE.description} />
  <meta property="og:url" content="https://xleia.github.io/" />
  <link rel="canonical" href="https://xleia.github.io/" />
  <link rel="preload" as="image" href="/studio/hero-coast.avif" type="image/avif" />
  <meta property="og:image" content="https://xleia.github.io/studio/hero-coast.avif" />
  <title>{SITE.name}</title>
</head>
<body id="page-top">
  <a class="skip-to-content" href="#main-content">跳转到正文</a>
  <section class="coast-hero" aria-labelledby="site-name">
    <img class="coast-photo" src="/studio/hero-coast.avif"
      alt="夕阳下的海滨小镇、灯光温暖的街角、海面与休息的猫咪" width="1024" height="576" fetchpriority="high" decoding="async" />
    <div class="coast-shade" aria-hidden="true"></div>
    <header class="coast-header">
      <a class="coast-brand" href="/" aria-label="H的学习小破站，返回首页">
        <strong>H的学习小破站</strong><span class="flower" aria-hidden="true">❧</span>
      </a>
      <nav class="coast-navigation" aria-label="网站导航">
        {links.map((item) => <a href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <details class="coast-mobile-nav">
        <summary aria-label="打开或关闭导航">☰ 菜单</summary>
        <nav aria-label="手机导航">
          {links.map((item) => <a href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>{item.label}</a>)}
          <a href="/studio/legacy/">旧工作室</a>
        </nav>
      </details>
    </header>
    <div class="coast-main-title">
      <p class="coast-kicker">Today’s Task : stay up all night</p>
      <h1 id="site-name">H的学习小破站</h1>
      <p class="coast-intro">今日任务：熬夜</p>
    </div>
    <a class="coast-scroll" href="#main-content" aria-label="向下滚动，查看最新文章"><b aria-hidden="true">⌄</b>向下探索</a>
  </section>
  <main class="coast-content" id="main-content">
    <div class="coast-wrap">
      <section class="coast-section" aria-labelledby="latest-heading">
        <div class="coast-section-heading">
          <div><p class="coast-eyebrow">WORDS & NOTES</p><h2 id="latest-heading">最新文章</h2></div>
          <a class="coast-more" href="/blog/">全部文章 ↗</a>
        </div>
        {featured && (
          <article class="coast-feature">
            <div class="coast-feature-art" aria-hidden="true"></div>
            <div class="coast-feature-copy">
              <div class="coast-meta"><span>{featured.data.category}</span><time datetime={date(featured.data.pubDate)}>{date(featured.data.pubDate)}</time></div>
              <h3><a href={featured.data.legacyPath}>{featured.data.title}</a></h3>
              
              <a class="coast-read" href={featured.data.legacyPath}>继续阅读 →</a>
            </div>
          </article>
        )}
        <div class="coast-rows">
          {latest.map((article) => (
            <article class="coast-row">
              <div class="coast-meta"><span>{article.data.category}</span><time datetime={date(article.data.pubDate)}>{date(article.data.pubDate)}</time></div>
              <h3><a href={article.data.legacyPath}>{article.data.title}</a></h3>
              <a class="coast-row-arrow" href={article.data.legacyPath} aria-label={`阅读：${article.data.title}`}>↗</a>
            </article>
          ))}
        </div>
      </section>
      <section class="coast-section" aria-labelledby="projects-heading">
        <div class="coast-section-heading">
          <div><p class="coast-eyebrow">MADE WITH CURIOSITY</p><h2 id="projects-heading">项目</h2></div>
          <a class="coast-more" href="/projects/">全部项目 ↗</a>
        </div>
        <div class="coast-projects">
          {PROJECTS.map((project) => (
            <a class="coast-project" href={projectPath(project)}>
              <span class="coast-project-symbol" aria-hidden="true">{project.symbol}</span>
              <h3>{project.name}</h3><p>{project.summary}</p>
              <span class="coast-project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
      <aside class="coast-ending" aria-label="更多页面">
        <a href="/about/">关于 →</a><a href="/studio/legacy/">原版工作室 →</a>
      </aside>
    </div>
  </main>
  <footer class="coast-footer">
    <strong>H的学习小破站</strong>
    <small>© {new Date().getFullYear()} Xleia</small>
    <a href="https://github.com/Xleia" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </footer>
</body>
</html>
