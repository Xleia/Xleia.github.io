---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const date = (value: Date) => value.toISOString().slice(0, 10);
---
<BaseLayout title="个人博客" description="Xleia 的开发与学习笔记。阅读 Java、Spring、Redis、Git 和数据结构文章。">
  <div class="journal">
    <header class="masthead">
      <h1>Xleia 的个人博客</h1>
      <p>我把开发时遇到的问题和学过的东西记在这里。</p>
    </header>

    <section aria-labelledby="notes">
      <header class="section-title">
        <h2 id="notes">最近的笔记</h2>
        <a href="/blog/">全部 {articles.length} 篇</a>
      </header>
      <ol class="notes">
        {articles.slice(0, 6).map(({data}) => (
          <li>
            <p class="byline"><time datetime={date(data.pubDate)}>{date(data.pubDate)}</time><span>{data.category}</span></p>
            <h3><a href={data.legacyPath}>{data.title}</a></h3>
          </li>
        ))}
      </ol>
    </section>
    <aside aria-label="关于作者与工作室">
      <a href="/about/">关于我</a><span aria-hidden="true">·</span><a href="/studio/room/">逛逛我的夜间工作室</a>
    </aside>
  </div>
</BaseLayout>

<style>
  .journal { max-width: 46rem; margin: 0 auto; }
  .masthead { padding: clamp(1rem, 4vw, 3rem) 0 2.2rem; }
  h1, h2, h3 { font-family: Georgia, "Songti SC", "Noto Serif CJK SC", serif; }
  h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -.045em; line-height: 1.2; }
  .masthead p, .byline, aside { color: var(--color-muted); }
  .section-title, aside, .byline { display: flex; align-items: baseline; gap: 1rem; }
  .section-title { justify-content: space-between; border-bottom: 1px solid var(--color-text); padding-bottom: .65rem; }
  h2 { margin: 0; font-size: 1.3rem; }
  .section-title a, aside { font-size: .9rem; }
  .notes { padding: 0; margin: 0; list-style: none; }
  .notes li { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  .byline { margin: 0; font-size: .82rem; font-variant-numeric: tabular-nums; flex-wrap: wrap; }
  h3 { font-size: clamp(1.1rem, 2.3vw, 1.45rem); margin: .35rem 0 0; line-height: 1.55; overflow-wrap: anywhere; }
  h3 a, aside a { color: inherit; text-decoration: none; }
  a:hover { color: var(--color-accent); text-decoration: underline; }
  aside { padding: 1.6rem 0; flex-wrap: wrap; }
</style>
