---
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { PROJECTS, projectPath } from '../data/projects';
import { LEGACY_CATEGORIES, LEGACY_TAGS } from '../data/legacyTaxonomy';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import '../styles/landing.css';

const articles = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());
const featured = articles[0];
const recent = articles.slice(1,7);
const formatDate = (d:Date) => d.toISOString().slice(0,10);
const excerpt = (raw:string) => raw.replace(/<[^>]*>/g,' ').replace(/!\[[^\]]*\]\([^)]*\)/g,' ')
  .replace(/\[([^\]]+)\]\([^)]*\)/g,'$1').replace(/[#*_~>|{}]/g,' ')
  .replace(/\s+/g,' ').trim().slice(0,170);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="description" content={SITE.description} />
  <meta name="theme-color" content="#344a62" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={SITE.name} />
  <meta property="og:description" content={SITE.description} />
  <meta property="og:url" content={SITE.url + '/'} />
  <link rel="canonical" href={SITE.url + '/'} />
  <link rel="icon" href="/img/favicon.png" />
  <link rel="preload" href="/img/default.png" as="image" />
  <title>{SITE.name}</title>
  <script is:inline>
    try { document.documentElement.dataset.theme = localStorage.getItem('xleia-theme') === 'dark' ? 'dark' : 'light'; }
    catch { document.documentElement.dataset.theme = 'light'; }
  </script>
</head>
<body id="page-top" data-room="home" class="home-body">
  <a href="#main-content" class="skip-link">跳转到正文</a>
  <SiteHeader overlay />
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-shade" aria-hidden="true"></div>
    <div class="landing-hero-content">
      <p class="landing-hero-eyebrow">{SITE.name}</p>
      <h1 id="landing-title">{SITE.brand}</h1>
      <p class="landing-hero-tagline">{SITE.tagline}</p>
      <p class="landing-hero-subtagline">{SITE.taglineZh}</p>
      <div class="landing-hero-actions">
        <a href="#main-content" class="landing-hero-primary">阅读文章 <span aria-hidden="true">→</span></a>
        <a href="/projects/" class="landing-hero-secondary">查看项目 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <a class="landing-scroll" href="#main-content" aria-label="向下滚动查看文章">
      <span class="landing-scroll-arrow" aria-hidden="true">↓</span>
    </a>
  </section>
  <main class="landing-main" id="main-content">
    <div class="landing-shell">
      <div class="landing-content-head">
        <div>
          <p class="section-overline">BLOG / RECENT</p>
          <h2>最新文章 <span class="headline-count">{articles.length} 篇</span></h2>
        </div>
        <a href="/archives/" class="landing-heading-link">浏览归档 ↗</a>
      </div>
      <nav class="landing-category-tabs" aria-label="原博客文章分类">
        <a href="/blog/" class="is-active">全部文章</a>
        {LEGACY_CATEGORIES.map(group=><a href={'/categories/'+encodeURIComponent(group.slug)+'/'}>{group.slug}</a>)}
      </nav>
      <div class="landing-columns">
        <section class="landing-feed" aria-label="文章列表">
          {featured && <article class="landing-featured">
            <a class="landing-featured-visual" href={featured.data.legacyPath} aria-label={'阅读文章：'+featured.data.title}>
              <span>DEVELOPMENT NOTES</span>
            </a>
            <div class="landing-featured-body">
              <div class="landing-post-meta"><span class="post-category">{featured.data.category}</span><time datetime={formatDate(featured.data.pubDate)}>{formatDate(featured.data.pubDate)}</time></div>
              <h3><a href={featured.data.legacyPath}>{featured.data.title}</a></h3>
              <p>{excerpt(featured.body ?? '')}</p>
              <a class="landing-read-more" href={featured.data.legacyPath}>阅读全文 →</a>
            </div>
          </article>}
          <div class="landing-feed-list">
            {recent.map(article=><article class="landing-post-item">
              <div class="landing-post-meta"><span class="post-category">{article.data.category}</span><time datetime={formatDate(article.data.pubDate)}>{formatDate(article.data.pubDate)}</time></div>
              <h3><a href={article.data.legacyPath}>{article.data.title}</a></h3>
              <p>{excerpt(article.body ?? '')}</p>
              <a href={article.data.legacyPath} class="landing-inline-link">阅读文章 ↗</a>
            </article>)}
          </div>
          <a class="landing-all-posts" href="/archives/">查看全部 {articles.length} 篇历史文章 →</a>
        </section>
        <aside class="landing-sidebar" aria-label="作者与博客导航">
          <section class="sidebar-panel sidebar-author">
            <div class="sidebar-author-backdrop" aria-hidden="true"></div>
            <img src="/img/avatar.png" alt="站点头像" class="sidebar-avatar" width="80" height="80" loading="lazy" />
            <h3>{SITE.brand}</h3>
            <p>{SITE.description}</p>
            <div class="sidebar-statistics">
              <a href="/archives/"><strong>{articles.length}</strong><span>文章</span></a>
              <a href="/categories/"><strong>{LEGACY_CATEGORIES.length}</strong><span>分类</span></a>
              <a href="/tags/"><strong>{LEGACY_TAGS.length}</strong><span>标签</span></a>
            </div>
            <div class="sidebar-author-links"><a href="/about/">关于作者 →</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
          </section>
          <section class="sidebar-panel sidebar-taxonomy">
            <h3>文章分类 <a href="/categories/" aria-label="查看全部分类">↗</a></h3>
            <ul>{LEGACY_CATEGORIES.map(group=><li><a href={'/categories/'+encodeURIComponent(group.slug)+'/'}>{group.slug}<span>{group.paths.length}</span></a></li>)}</ul>
          </section>
          <section class="sidebar-panel sidebar-tag-panel">
            <h3>文章标签 <a href="/tags/" aria-label="查看全部标签">↗</a></h3>
            <div class="sidebar-tags">{LEGACY_TAGS.map(tag=><a href={'/tags/'+encodeURIComponent(tag.slug)+'/'}>#{tag.slug}</a>)}</div>
          </section>
          <section class="sidebar-panel sidebar-quick-links">
            <h3>更多内容</h3>
            <a href="/projects/">项目 ↗</a>
            <a href="/lab/">实验室 ↗</a>
            <a href="/studio/legacy/">原版工作室 ↗</a>
          </section>
        </aside>
      </div>
      <section class="landing-projects" aria-labelledby="landing-projects-heading">
        <div class="landing-project-heading"><div><p class="section-overline">PROJECTS</p><h2 id="landing-projects-heading">项目</h2></div><a href="/projects/">查看全部 →</a></div>
        <div class="landing-project-list">
          {PROJECTS.map(project=><a href={projectPath(project)} class="landing-project">
            <span class="landing-project-symbol" aria-hidden="true">{project.symbol}</span>
            <span class="landing-project-content"><strong>{project.name}</strong><small>{project.summary}</small></span>
            <span class="landing-project-arrow" aria-hidden="true">↗</span>
          </a>)}
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</body>
</html>
