---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
---
<BaseLayout title="关于" description="关于 Xleia 的个人工作室、技术笔记与项目。">
  <section class="page-intro">
    <p class="eyebrow">工作室 / 留言板</p>
    <h1>关于 Xleia</h1>
    <p class="lead">这里是我的个人博客。书架上收着学习笔记，电脑里放着我做的项目。</p>
  </section>
  <section class="desk-note">
    <h2>在别处找到我</h2>
    <p>我把公开的代码和开发记录放在 GitHub。</p>
    <a class="text-link" href={SITE.github}>github.com/Xleia ↗</a>
  </section>
</BaseLayout>
