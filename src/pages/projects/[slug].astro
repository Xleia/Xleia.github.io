---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS, type Project, projectPath } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={project.name} description={project.summary}>
  <article class="project-detail">
    <nav class="breadcrumb" aria-label="面包屑导航">
      <a href="/">首页</a><span aria-hidden="true">/</span>
      <a href="/projects/">项目</a><span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>
    <header class="project-detail-header">
      <span class="project-symbol project-symbol-large" aria-hidden="true">{project.symbol}</span>
      <p class="eyebrow">{project.category}</p>
      <h1>{project.name}</h1>
      <p class="lead">{project.summary}</p>
    </header>
    <section class="project-detail-section" aria-labelledby="project-about">
      <h2 id="project-about">项目介绍</h2>
      <p>{project.description}</p>
    </section>
    <section class="project-detail-section" aria-labelledby="project-features">
      <h2 id="project-features">主要方向</h2>
      <ul class="feature-list">
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </section>
    <section class="project-detail-section" aria-labelledby="project-stack">
      <h2 id="project-stack">技术栈</h2>
      <div class="tech-tags">
        {project.technologies.map((tech) => <span class="tech-tag">{tech}</span>)}
      </div>
    </section>
    <aside class="project-availability" aria-label="公开访问状态">
      <strong>访问与下载</strong>
      <p>{project.availability}。本页面用于项目展示，尚未提供经过验证的公开外部入口。</p>
    </aside>
    <a class="text-link" href="/projects/">← 返回项目列表</a>
  </article>
</BaseLayout>
