---
import { getCollection } from 'astro:content';
import { NAV_ITEMS } from '../../../data/site';
const reading = (await getCollection('blog')).sort((a,b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0,3);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="坐在 Xleia 的夜间工作室，看窗外的东京夜景和桌上的漫画。" />
  <link rel="canonical" href="https://xleia.github.io/" />
  <title>窗前工作室 · Xleia Studio</title>
  <style is:inline>
    *{box-sizing:border-box}html,body{margin:0;background:#151316;color:#eee5da;font-family:system-ui,sans-serif}
    main{position:fixed;inset:0;overflow:hidden}
    .room{position:absolute;width:max(100vw,177.69vh);width:max(100vw,177.69dvh);aspect-ratio:1672/941;left:50%;top:50%;transform:translate(-50%,-50%);user-select:none;pointer-events:none}
    .poster{display:block;width:100%;height:100%}
    @media(max-aspect-ratio:1/1){.room{left:calc(50% - 17dvh)}}
    .glass,.viaduct,.steam{position:absolute;overflow:hidden;pointer-events:none}
    .glass{left:58%;top:10%;width:18.3%;height:27%}
    .viaduct{left:67.96%;top:36.92%;width:8.31%;height:1.05%}
    .carriages{position:absolute;top:18%;width:70%;height:70%;border-radius:20% 30% 6% 8%;background:repeating-linear-gradient(90deg,#28313c 0 2%,#c38d5a 2% 4%,#e3b987 4% 6%,#4e4543 6% 9%);border-block:1px solid #31363b;filter:blur(.45px);animation:train 31s linear infinite}
    @keyframes train{0%,9%{transform:translateX(-105%)}31%,100%{transform:translateX(148%)}}
    .steam{left:68.4%;top:61.5%;width:4.5%;height:10%;mask-image:linear-gradient(transparent,#000 34%,#000 88%,transparent)}
    .steam::before,.steam::after{content:"";position:absolute;inset:12% 36% -12%;border-left:2px solid #f4e2c7;border-radius:50%;filter:blur(2px);animation:steam-rise 5.8s ease-out infinite}
    .steam::after{inset:23% 24% -8% 48%;animation-delay:-3s}
    @keyframes steam-rise{0%{opacity:0;transform:translateY(32%) rotate(6deg)}32%{opacity:.24}100%{opacity:0;transform:translate(-20%,-42%) rotate(-14deg)}}
    .resting *{animation-play-state:paused!important}
    @media(prefers-reduced-motion:reduce){.glass,.viaduct,.steam{display:none}.room *{animation:none!important}}
    details{position:fixed;top:max(18px,env(safe-area-inset-top));right:max(20px,env(safe-area-inset-right));z-index:2}
    summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:9px;margin-left:auto;width:max-content;min-height:38px;padding:7px 16px;border:1px solid #ffffff47;border-radius:24px;background:#211d1bbf;color:#f2eae2;font-size:14px;backdrop-filter:blur(10px)}
    summary::-webkit-details-marker{display:none}summary span{font-size:15px}summary:focus-visible,a:focus-visible{outline:2px solid #f2c88e;outline-offset:3px}
    nav{min-width:210px;max-height:calc(100dvh - 85px);overflow:auto;margin-top:8px;padding:8px;border:1px solid #ffffff30;background:#211d1bf2;border-radius:12px;box-shadow:0 10px 35px #0005}
    nav a{display:block;color:#eee5da;padding:11px 14px;border-radius:6px;text-decoration:none;font-size:14px}nav a:hover,nav a:focus-visible{background:#ffffff13}
    button{font:inherit;color:inherit;cursor:pointer}
    .lamp-off{position:absolute;left:20.993%;top:29.756%;width:19.079%;height:28.906%;opacity:0;transition:opacity .35s}
    .rain,.lamp-pool{position:absolute;pointer-events:none}
    .room-rain{left:39.23445%;top:6.80128%;width:37.55981%;height:35.28162%}
    .window-rain{inset:0;width:100%;height:100%}
    .lamp-pool{left:23%;top:37%;width:23%;height:22%;background:radial-gradient(ellipse at 48% 78%,#f4ae5e1e,transparent 68%);mix-blend-mode:screen;transition:opacity .35s}
    .room.dark .lamp-pool{opacity:0}
    .room.dark .lamp-off{opacity:1}
    .spot{pointer-events:auto;position:absolute;background:transparent;border:0;border-radius:12px;min-height:44px;min-width:44px}
    .spot span{display:inline-block;white-space:nowrap;opacity:0;background:#211d1bd9;padding:6px 12px;border-radius:20px;font-size:14px}
    .spot:hover span,.spot:focus-visible span{opacity:1}
    .lamp{left:30%;top:29%;width:8%;height:16%}.window{left:57%;top:10%;width:19%;height:29%}
    .tip,.return{position:absolute;bottom:max(20px,env(safe-area-inset-bottom));background:#211d1bdb;padding:9px 15px;border-radius:22px;font-size:14px}
    .tip{left:50%;transform:translateX(-50%);margin:0;white-space:nowrap;pointer-events:none}
    .return{left:20px;border:1px solid #ffffff55}
    .passage{position:absolute;inset:0;width:100%;height:100%;touch-action:none}
    .view{position:absolute;inset:0;background:#191c23;overflow:hidden}
    .view img,.mist{position:absolute;width:100%;height:100%;object-fit:cover}
    .mist{touch-action:none;cursor:crosshair}
    .plane{position:absolute;inset:0;transform-origin:64% 24%}
    .camera{position:absolute;inset:0}
    main{touch-action:none}
    .layer-photo,.chair,.foreground{position:absolute;pointer-events:none}
    .layer-photo{inset:0;width:100%;height:100%}
    .chair{left:26.734%;top:48.672%;width:19.019%}
    .foreground{left:26.196%;top:54.835%;width:73.804%}
    .plane .layer-photo,.chair,.foreground{visibility:hidden}
    .layered .layer-photo,.layered .chair,.layered .foreground{visibility:visible}
    .layered .poster{visibility:hidden}
    .layered .plane{transform-origin:center;transform:scale(1.16)}
    .layered.walking .plane{
      --advance:calc(var(--walk) * (.48 + .65 * var(--depth)));
      --reach:calc(50% * var(--advance));
      transform:translate(clamp(calc(-1 * var(--reach)),calc(var(--walk-x) * (1 + var(--depth))),var(--reach)),clamp(calc(-1 * var(--reach)),calc(var(--walk-y) * (1 + var(--depth))),var(--reach))) scale(calc(1.16 + var(--advance)))
    }
    a.spot{display:grid;place-items:center;text-decoration:none;color:var(--ink)}
    .spot.portal span,.spot.shelf span{opacity:1;border:1px solid var(--edge);font:14px/1.5 system-ui,sans-serif}
    .spot.portal:hover span,.spot.shelf:hover span{border-color:var(--gold)}
    .monitor{left:39%;top:34%;width:19%;height:16%}
    .computer{left:80%;top:42%;width:7%;height:14%}
    .board{left:87%;top:17%;width:10%;height:22%}
    .shelf{left:6%;top:13%;width:17%;height:54%}
    .sketch{left:40%;top:77%;width:27%;height:20%}
    .detail{position:absolute;inset:0;overflow:hidden;background:#151316;container-type:size}
    .detail img{position:absolute;left:50%;top:50%;width:max(calc(100cqw / var(--crop)),calc(100cqh * 1.777 / var(--height)));transform:translate(var(--cx),var(--cy))}
    .detail[data-scene="shelf"]{--crop:.25;--height:.65;--cx:-14%;--cy:-42%}
    .detail[data-scene="sketch"]{--crop:.47;--height:.26;--cx:-53%;--cy:-86%}

    @media(prefers-reduced-motion:reduce){.layered.walking .plane{transform:none}}
    .wall{--depth:.18}.middle{--depth:.62}.front{--depth:1}
    .layered.travel .plane{transition:transform .85s cubic-bezier(.35,0,.35,1)}
    @media(prefers-reduced-motion:reduce){.layered .plane{transform:none}.layered.travel .plane{transition:none}}
    nav button{display:block;width:100%;text-align:left;padding:11px 14px;border:0;border-radius:6px;background:none;font-size:14px}
    nav button:hover,nav button:focus-visible{background:#ffffff13}
    button:focus-visible,canvas:focus-visible{outline:2px solid #f2c88e;outline-offset:-3px}
    .view .tip{bottom:74px}
    @media(max-aspect-ratio:1/1){.spot.lamp{display:none}}
    @media(prefers-reduced-motion:reduce){.view:not([hidden]){animation:none}.lamp-off{transition:none}}
    :root{--ink:#f6e9d4;--wood:#211d19ed;--edge:#d6ba893f;--gold:#e3ba80;--pad:clamp(12px,3vw,32px);color-scheme:dark}
    .location,summary,.return,.tip,.paper-tools button,nav,.catalogue{color:var(--ink);border:1px solid var(--edge);background:var(--wood);box-shadow:0 3px 18px #0004}
    .location{position:fixed;z-index:1;left:var(--pad);top:max(18px,env(safe-area-inset-top));margin:0;padding:9px 14px;border-radius:24px;pointer-events:none;font:14px/1.4 Georgia,serif}
    .location small{font:inherit;color:var(--gold);padding-right:9px}
    .return,.paper-tools button,summary{min-height:44px}
    .tip{max-width:calc(100% - 24px);white-space:normal;text-align:center;width:max-content}
    .catalogue,.paper-desk{position:absolute;right:var(--pad);bottom:max(84px,12vh);max-height:calc(100% - 160px);overflow:auto;overscroll-behavior:contain;touch-action:pan-y}
    .catalogue{width:min(360px,calc(100% - 2 * var(--pad)));padding:20px;border-radius:12px}
    .catalogue h2{font:normal 24px/1.2 Georgia,serif;margin:0 0 12px}.catalogue a{display:block;padding:9px 0;color:var(--ink);text-decoration:none;border-top:1px solid var(--edge)}
    .catalogue a:hover,.catalogue a:focus-visible{color:var(--gold);text-decoration:underline}.catalogue small{display:block;color:#d5bd99}
    .detail:has(.paper-desk:not([hidden]))>img{filter:brightness(.62)}
    .paper-desk{left:50%;right:auto;top:50%;bottom:auto;transform:translate(-50%,-50%);width:min(92vw,95dvh,940px);max-height:none;overflow:visible;outline:none}
    .book{container-type:inline-size;position:relative;display:flex;aspect-ratio:4/3;perspective:1600px;background:#d8c7a6;border:3px solid #50362a;border-radius:4px 7px 7px 4px;box-shadow:0 3px #ac987a,0 5px #625246,0 14px 32px #0009;touch-action:pan-y}
    .page,.face{background:#eee2c8;position:relative;display:grid;place-items:center;overflow:hidden;color:#302822;text-align:center}
    .page{width:50%;height:100%}.book img{position:static;display:block;width:100%;height:100%;object-fit:fill;transform:none;pointer-events:none}
    .page:after,.face:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,#30201633,transparent 11%,transparent 96%,#3020160d)}
    .left:after,.verso:after{transform:scaleX(-1)}.leaf{position:absolute;inset:0 0 0 50%;transform-origin:left;transform-style:preserve-3d;pointer-events:none}
    .face{position:absolute;inset:0;backface-visibility:hidden}.verso{transform:rotateY(180deg)}
    .book strong{font:normal clamp(14px,5cqw,46px)/1.3 Georgia,serif;letter-spacing:.12em;writing-mode:vertical-rl}.book small{display:block;margin-top:1em;color:#745b43;letter-spacing:.16em}
    .paper-tools{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:12px}.paper-tools button{border-radius:24px;padding:6px 14px}.paper-tools button:disabled{opacity:.45}
    .paper-status{background:#211d19ed;color:var(--ink);padding:5px 12px;border-radius:14px;font-size:13px}
    .touch-copy{display:none}
    @media(pointer:coarse){.wheel-copy{display:none}.touch-copy{display:inline}}
    @media(max-height:480px){.paper-desk{width:min(64vw,85dvh)}.catalogue{bottom:14px;max-height:calc(100% - 78px)}}
    [hidden]{display:none!important}
  </style>
</head>
<body>
  <main tabindex="0" aria-label="Xleia 工作室">
    <p class="location"><small>Xleia Studio</small><span aria-live="polite">沙发</span></p>
    <div class="room">
      <div class="camera">
      <div class="plane wall">
      <img class="poster" src="/studio/sketch-assets/night.webp" width="1672" height="941" fetchpriority="high" draggable="false" alt="茶几上摊着一本漫画，抬头可以看到画中的塔。暖灯照着书架，窗外落着细雨。" />
      <img class="layer-photo" src="/studio/sketch-assets/far.webp" alt="" />
      <div class="lamp-pool" aria-hidden="true"></div>
      <img class="lamp-off" src="/studio/sketch-assets/lamp-off.webp" alt="" />
      <button class="spot lamp" data-lamp aria-pressed="true" aria-label="桌灯"><span>桌灯</span></button>
      <button class="spot window" data-place="window" data-window><span>走到窗边</span></button>
      <button class="spot shelf" data-place="shelf"><span>读文章</span></button>
      <a class="spot portal monitor" href="/projects/"><span>项目</span></a>
      <a class="spot portal computer" href="/lab/"><span>实验室</span></a>
      <a class="spot portal board" href="/about/"><span>关于我</span></a>
      <canvas class="rain room-rain" data-rain="room" aria-hidden="true"></canvas>
      <canvas class="glass" aria-hidden="true"></canvas>
      <div class="viaduct" aria-hidden="true"><i class="carriages"></i></div>
      </div>
      <div class="plane middle"><img class="chair" src="/studio/sketch-assets/seat.webp" alt="" /></div>
      <div class="plane front"><img class="foreground" src="/studio/sketch-assets/near.webp" alt="" />
      <button class="spot sketch" data-place="sketch"><span>读桌上的漫画</span></button>
      <div class="steam" aria-hidden="true"></div>
      </div>
      </div>
    </div>
    <canvas class="passage" aria-hidden="true" hidden></canvas>
    <p class="tip" id="room-tip"><span class="wheel-copy">点书架读文章，点显示器看项目；向窗户滚动可走近</span><span class="touch-copy">轻点物件，或从目录选择去处</span></p>
    <section class="view" aria-label="窗边" hidden>
      <img src="/studio/sketch-assets/window-seat.webp" alt="隔着雨夜的玻璃望向城市灯火" />
      <canvas class="rain window-rain" data-rain="window" aria-hidden="true"></canvas>
      <canvas class="mist" tabindex="0" aria-label="起雾的窗玻璃，拖动或按空格擦开"></canvas>
      <p class="tip" id="glass-tip">拖动擦开窗雾 · 也可以按空格</p>
      <button class="return">坐回沙发</button>
    </section>
    <section class="detail" aria-label="室内近景" hidden>
      <img src="/studio/sketch-assets/night.webp" alt="" />
      <button class="return">坐回沙发</button>
      <aside class="catalogue" aria-labelledby="reading-title" hidden>
        <h2 id="reading-title">架上的笔记</h2>
        {reading.map(article => <a href={article.data.legacyPath}><small>{article.data.category}</small>{article.data.title}</a>)}
        <a href="/blog/">全部文章</a>
      </aside>
      <section class="paper-desk" tabindex="-1" aria-label="夜色落在猫爪上，桌上的短篇漫画" hidden>
        <div class="book">
          <div class="page left"></div><div class="page right"></div>
          <div class="leaf" aria-hidden="true" hidden><div class="face"></div><div class="face verso"></div></div>
        </div>
        <div class="paper-tools">
          <button type="button" data-prev>上一页</button>
          <span class="paper-status" aria-live="polite"></span>
          <button type="button" data-next>下一页</button>
        </div>
      </section>
    </section>
  </main>
  <details><summary><span aria-hidden="true">☰</span>目录</summary><nav aria-label="工作室目录">
    <button data-place="window" data-window>走到窗边</button>
    <button data-place="shelf">走到书架</button>
    <button data-place="sketch">读桌上的漫画</button>
    <button data-lamp aria-pressed="true">桌灯</button>
    {NAV_ITEMS.filter(item => item.href !== '/').map(item => <a href={item.href}>{item.label}</a>)}
  </nav></details>
  <script>
    import '../../../scripts/studio-sketch-evening.js';
    import '../../../scripts/studio-presence.js';
    import '../../../scripts/studio-rain.js';
    import '../../../scripts/studio-comic.js';
  </script>
</body>
</html>
