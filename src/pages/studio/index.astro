---
import { STUDIO_ZONES } from '../../data/studio';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="坐在 Xleia 的夜间工作室，看窗外的东京夜景和桌上的速写。" />
  <link rel="canonical" href="https://xleia.github.io/studio/" />
  <title>窗前速写 · Xleia Studio</title>
  <style is:inline>
    *{box-sizing:border-box}html,body{margin:0;background:#151316;color:#eee5da;font-family:system-ui,sans-serif}
    main{position:fixed;inset:0;overflow:hidden}
    .room{position:absolute;width:max(100vw,177.69vh);width:max(100vw,177.69dvh);aspect-ratio:1672/941;left:50%;top:50%;transform:translate(-50%,-50%);user-select:none;pointer-events:none}
    .poster{display:block;width:100%;height:100%}
    @media(max-aspect-ratio:1/1){.room{left:calc(50% - 17dvh)}}
    .glass,.viaduct,.steam{position:absolute;overflow:hidden;pointer-events:none}
    .glass{left:58%;top:10%;width:18.3%;height:27%}
    .viaduct{left:67.96%;top:36.92%;width:8.31%;height:1.05%}
    .carriages{position:absolute;top:18%;width:70%;height:70%;border-radius:20% 30% 6% 8%;background:repeating-linear-gradient(90deg,#28313c 0 2%,#c38d5a 2% 4%,#e3b987 4% 6%,#4e4543 6% 9%);border-block:1px solid #31363b;filter:blur(.45px);animation:train 31s linear infinite}
    @keyframes train{0%,9%{transform:translateX(-105%)}31%,100%{transform:translateX(148%)}}
    .steam{left:69.4%;top:60.5%;width:7%;height:10.4%;mask-image:radial-gradient(ellipse at 48% 60%,black 22%,transparent 69%);}
    .steam img{position:absolute;width:1428.5714%;max-width:none;left:-991.4286%;top:-581.7308%;animation:drift 7.8s ease-in-out infinite alternate}
    @keyframes drift{from{transform:translate(0,0)}to{transform:translate(.29%,-.26%)}}
    .resting *{animation-play-state:paused!important}
    @media(prefers-reduced-motion:reduce){.glass,.viaduct,.steam{display:none}.room *{animation:none!important}}
    details{position:fixed;top:max(18px,env(safe-area-inset-top));right:max(20px,env(safe-area-inset-right));z-index:2}
    summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:9px;margin-left:auto;width:max-content;min-height:38px;padding:7px 16px;border:1px solid #ffffff47;border-radius:24px;background:#211d1bbf;color:#f2eae2;font-size:14px;backdrop-filter:blur(10px)}
    summary::-webkit-details-marker{display:none}summary span{font-size:15px}summary:focus-visible,a:focus-visible{outline:2px solid #f2c88e;outline-offset:3px}
    nav{min-width:210px;max-height:calc(100dvh - 85px);overflow:auto;margin-top:8px;padding:8px;border:1px solid #ffffff30;background:#211d1bf2;border-radius:12px;box-shadow:0 10px 35px #0005}
    nav a{display:block;color:#eee5da;padding:11px 14px;border-radius:6px;text-decoration:none;font-size:14px}nav a:hover,nav a:focus-visible{background:#ffffff13}
    button{font:inherit;color:inherit;cursor:pointer}
    .lamp-off{position:absolute;left:20.993%;top:29.756%;width:19.079%;height:28.906%;opacity:0;transition:opacity .35s}
    .room.dark .lamp-off{opacity:1}
    .spot{pointer-events:auto;position:absolute;background:transparent;border:0;border-radius:12px;min-height:44px;min-width:44px}
    .spot span{display:inline-block;white-space:nowrap;opacity:0;background:#211d1bd9;padding:6px 12px;border-radius:20px;font-size:14px}
    .spot:hover span,.spot:focus-visible span{opacity:1}
    .lamp{left:30%;top:29%;width:8%;height:16%}.window{left:57%;top:10%;width:19%;height:29%}
    .tip,.return{position:absolute;bottom:max(20px,env(safe-area-inset-bottom));background:#211d1bdb;padding:9px 15px;border-radius:22px;font-size:14px}
    .tip{left:50%;transform:translateX(-50%);margin:0;white-space:nowrap;pointer-events:none}
    .return{left:20px;border:1px solid #ffffff55}
    .view{position:absolute;inset:0;background:#191c23;overflow:hidden}
    .view img,.mist{position:absolute;width:100%;height:100%;object-fit:cover}
    .mist{touch-action:none;cursor:crosshair}
    .plane{position:absolute;inset:0;transform-origin:64% 24%}
    .room{touch-action:none;perspective:var(--focal,1200px);perspective-origin:var(--eye-x,50%) 50%}
    .camera{position:absolute;inset:0;transform-origin:var(--eye-x,50%) 50% var(--focal,1200px);transform:rotateY(var(--yaw,0deg))}
    @media(prefers-reduced-motion:reduce){.camera{transform:none}}
    main{touch-action:none}
    .layer-photo,.chair,.foreground{position:absolute;pointer-events:none}
    .layer-photo{inset:0;width:100%;height:100%}
    .chair{left:26.734%;top:48.672%;width:19.019%}
    .foreground{left:26.196%;top:54.835%;width:73.804%}
    .plane .layer-photo,.chair,.foreground{visibility:hidden}
    .layered .layer-photo,.layered .chair,.layered .foreground{visibility:visible}
    .layered .poster{visibility:hidden}
    .layered .plane{transform-origin:center;transform:scale(1.16)}
    .layered.walking .plane{
      --advance:calc(var(--walk) * (.48 + .65 * var(--depth)));
      --reach:calc(50% * var(--advance));
      transform:translate(clamp(calc(-1 * var(--reach)),calc(var(--walk-x) * (1 + var(--depth))),var(--reach)),clamp(calc(-1 * var(--reach)),calc(var(--walk-y) * (1 + var(--depth))),var(--reach))) scale(calc(1.16 + var(--advance)))
    }
    .shelf{left:6%;top:13%;width:17%;height:54%}
    .sketch{left:40%;top:77%;width:27%;height:20%}
    .detail{position:absolute;inset:0;overflow:hidden;background:#151316;container-type:size}
    .detail img{position:absolute;left:50%;top:50%;width:max(calc(100cqw / var(--crop)),calc(100cqh * 1.777 / var(--height)));transform:translate(var(--cx),var(--cy))}
    .detail[data-scene="shelf"]{--crop:.25;--height:.65;--cx:-14%;--cy:-42%}
    .detail[data-scene="sketch"]{--crop:.47;--height:.26;--cx:-53%;--cy:-86%}
    .detail a{position:absolute;bottom:24px;right:20px;padding:9px 15px;border-radius:22px;background:#211d1bdb;color:inherit}
    @media(prefers-reduced-motion:reduce){.layered.walking .plane{transform:none}}
    .wall{--depth:.18}.middle{--depth:.62}.front{--depth:1}
    .layered.travel .plane{transition:transform .85s cubic-bezier(.35,0,.35,1)}
    @media(prefers-reduced-motion:reduce){.layered .plane{transform:none}.layered.travel .plane{transition:none}}
    nav button{display:block;width:100%;text-align:left;padding:11px 14px;border:0;border-radius:6px;background:none;font-size:14px}
    nav button:hover,nav button:focus-visible{background:#ffffff13}
    button:focus-visible,canvas:focus-visible{outline:2px solid #f2c88e;outline-offset:-3px}
    .view .tip{bottom:74px}
    @media(max-aspect-ratio:1/1){.spot.lamp{display:none}}
    @media(prefers-reduced-motion:reduce){.view:not([hidden]){animation:none}.lamp-off{transition:none}}
  </style>
</head>
<body>
  <main tabindex="0" aria-label="窗前速写，可拖动或用左右方向键环顾">
    <div class="room">
      <div class="camera">
      <div class="plane wall">
      <img class="poster" src="/studio/sketch-assets/night.webp" width="1672" height="941" fetchpriority="high" draggable="false" alt="茶几上摊着一幅东京夜景速写，抬头可以看到画中的塔。暖灯照着书架，窗外落着细雨。" />
      <img class="layer-photo" src="/studio/sketch-assets/far.webp" alt="" />
      <img class="lamp-off" src="/studio/sketch-assets/lamp-off.webp" alt="" />
      <button class="spot lamp" data-lamp aria-pressed="true" aria-label="桌灯"><span>桌灯</span></button>
      <button class="spot window" data-place="window" data-window><span>走到窗边</span></button>
      <button class="spot shelf" data-place="shelf"><span>走到书架</span></button>
      <canvas class="glass" aria-hidden="true"></canvas>
      <div class="viaduct" aria-hidden="true"><i class="carriages"></i></div>
      </div>
      <div class="plane middle"><img class="chair" src="/studio/sketch-assets/seat.webp" alt="" /></div>
      <div class="plane front"><img class="foreground" src="/studio/sketch-assets/near.webp" alt="" />
      <button class="spot sketch" data-place="sketch"><span>俯看速写本</span></button>
      <div class="steam" aria-hidden="true"><img src="/studio/sketch-assets/night.webp" alt="" /></div>
      </div>
      </div>
    </div>
    <p class="tip" id="room-tip">指向书架、窗户或速写本 · 向上滚动走近</p>
    <section class="view" aria-label="窗边" hidden>
      <img src="/studio/sketch-assets/window-seat.webp" alt="隔着雨夜的玻璃望向城市灯火" />
      <canvas class="mist" tabindex="0" aria-label="起雾的窗玻璃，拖动或按空格擦开"></canvas>
      <p class="tip" id="glass-tip">拖动擦开窗雾 · 也可以按空格</p>
      <button class="return">坐回沙发</button>
    </section>
    <section class="detail" aria-label="室内近景" hidden>
      <img src="/studio/sketch-assets/night.webp" alt="" />
      <button class="return">坐回沙发</button>
      <a href="/blog/">浏览架上的文章</a>
    </section>
  </main>
  <details><summary><span aria-hidden="true">☰</span>目录</summary><nav aria-label="工作室目录">
    <button data-place="window" data-window>走到窗边</button>
    <button data-place="shelf">走到书架</button>
    <button data-place="sketch">俯看速写本</button>
    <button data-lamp aria-pressed="true">桌灯</button>
    <a href="/">首页</a>
    {STUDIO_ZONES.map(zone => <a href={zone.href}>{zone.name}</a>)}
  </nav></details>
  <script>
    import '../../scripts/studio-sketch-evening.js';
    import '../../scripts/studio-presence.js';
  </script>
</body>
</html>
